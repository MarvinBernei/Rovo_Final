  {
    "id": "rb",
    "type": "ui-base",
    "name": "ROVO Neuaufbau",
    "path": "/rovo-neu",
    "includeClientData": true,
    "acceptsClientConfig": [
      "ui-control",
      "ui-notification"
    ],
    "showPathInSidebar": false,
    "showPageTitle": true,
    "navigationStyle": "default",
    "titleBarStyle": "default"
  },
  {
    "id": "rt",
    "type": "ui-theme",
    "name": "ROVO Dunkel",
    "colors": {
      "surface": "#152333",
      "primary": "#39d6c8",
      "bgPage": "#0b1420",
      "groupBg": "#152333",
      "groupOutline": "#294057"
    },
    "sizes": {
      "density": "default",
      "pagePadding": "16px",
      "groupGap": "16px",
      "groupBorderRadius": "12px",
      "widgetGap": "12px"
    }
  },
  {
    "id": "poll",
    "type": "inject",
    "z": "rf",
    "name": "Status alle 2 s",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "2",
    "once": true,
    "onceDelay": 1,
    "payload": "",
    "payloadType": "date",
    "x": 140,
    "y": 60,
    "wires": [
      [
        "statusreq"
      ]
    ]
  },
  {
    "id": "statusreq",
    "type": "function",
    "z": "rf",
    "name": "GET Status mit Token",
    "func": "const t=env.get(\"ROVO_API_TOKEN\");if(!t||t.length<32){node.status({fill:\"red\",shape:\"ring\",text:\"Token fehlt\"});return {payload:{offline:true},url:\"http://127.0.0.1:1891/api/v1/status\",method:\"GET\"};}msg.method=\"GET\";msg.url=\"http://127.0.0.1:1891/api/v1/status\";msg.headers={Authorization:\"Bearer \"+t};return msg;",
    "outputs": 1,
    "x": 390,
    "y": 60,
    "wires": [
      [
        "statushttp"
      ]
    ]
  },
  {
    "id": "statushttp",
    "type": "http request",
    "z": "rf",
    "name": "ROVO Status",
    "method": "use",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "persist": false,
    "senderr": false,
    "headers": [],
    "x": 640,
    "y": 60,
    "wires": [
      [
        "statusclean"
      ]
    ]
  },
  {
    "id": "statusclean",
    "type": "function",
    "z": "rf",
    "name": "Nur Status an Browser",
    "func": "return {payload:msg.statusCode===200&&msg.payload?.schema===\"rovo.status.v1\"?msg.payload:{offline:true,updated_at_utc:new Date().toISOString()}};",
    "outputs": 1,
    "x": 860,
    "y": 60,
    "wires": [
      [
        "widget-overview",
        "widget-motion",
        "widget-camera",
        "widget-display",
        "widget-chat",
        "widget-assistant",
        "widget-system"
      ]
    ]
  },
  {
    "id": "cmdreq",
    "type": "function",
    "z": "rf",
    "name": "POST zum gemeinsamen Core",
    "func": "const t=env.get(\"ROVO_API_TOKEN\");if(!t||t.length<32){node.error(\"ROVO_API_TOKEN fehlt\");return null;}const p=msg.payload;if(!p||typeof p.type!==\"string\")return null;msg.payload={schema:\"rovo.command.v1\",type:p.type,args:p.args||{}};msg.method=\"POST\";msg.url=\"http://127.0.0.1:1891/api/v1/command\";msg.headers={Authorization:\"Bearer \"+t,\"Content-Type\":\"application/json\",\"X-ROVO-Session\":String(msg._client?.socketId||\"dashboard\")};return msg;",
    "outputs": 1,
    "x": 400,
    "y": 180,
    "wires": [
      [
        "cmdhttp"
      ]
    ]
  },
  {
    "id": "cmdhttp",
    "type": "http request",
    "z": "rf",
    "name": "ROVO Befehl",
    "method": "use",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "persist": false,
    "senderr": false,
    "headers": [],
    "x": 640,
    "y": 180,
    "wires": [
      [
        "cmdclean"
      ]
    ]
  },
  {
    "id": "cmdclean",
    "type": "function",
    "z": "rf",
    "name": "Nur Ergebnis an Client",
    "func": "return {_client:msg._client,payload:msg.payload?.schema===\"rovo.result.v1\"?msg.payload:{spoken_reply:\"Backend nicht erreichbar.\",status:\"error\",ok:false}};",
    "outputs": 1,
    "x": 870,
    "y": 180,
    "wires": [
      [
        "widget-overview",
        "widget-motion",
        "widget-camera",
        "widget-display",
        "widget-chat",
        "widget-assistant",
        "widget-system"
      ]
    ]
  },
  {
    "id": "catch",
    "type": "catch",
    "z": "rf",
    "name": "Bridge-Fehler",
    "scope": null,
    "uncaught": false,
    "x": 140,
    "y": 300,
    "wires": [
      [
        "offline"
      ]
    ]
  },
  {
    "id": "offline",
    "type": "function",
    "z": "rf",
    "name": "Offline statt Dummywerte",
    "func": "return {payload:{offline:true,updated_at_utc:new Date().toISOString()}};",
    "outputs": 1,
    "x": 420,
    "y": 300,
    "wires": [
      [
        "widget-overview",
        "widget-motion",
